{
  "rules": [
    {
      "regexp": "(?<![\\w/.:@+=%-])g:([\\w.+-]*\\w)",
      "link": "http://google.com/search?q=$1",
      "cssclass": ""
    },
    {
      "regexp": "(?<![\\w/.:@+=%-])go/([\\w#/?=&%+~.-]*[\\w#/=&%+~])",
      "link": "http://go/$1",
      "cssclass": ""
    },
    {
      "regexp": "(?<![\\w/.:@+=%-])b/(\\d+(?:#[\\w-]+)?)(?!\\w)",
      "link": "http://b/$1",
      "cssclass": ""
    },
    {
      "regexp": "(?<![\\w/.:@+=%-])cl/(\\d+(?:#[\\w-]+)?)(?!\\w)",
      "link": "http://cl/$1",
      "cssclass": ""
    },
    {
      "regexp": "(?<![\\w/.:@+=%-])who/([\\w.-]*\\w)",
      "link": "http://who/$1",
      "cssclass": ""
    },
    {
      "regexp": "(?<![\\w/.:@+=%-])([a-zA-Z0-9._-]*[a-zA-Z0-9])@google\\.com(?![\\w.-]*\\w)",
      "link": "http://who/$1",
      "cssclass": ""
    },
    {
      "regexp": "(?<![\\w/.:@+=%-])([a-zA-Z0-9._-]*[a-zA-Z0-9])@(?!\\w)",
      "link": "http://who/$1",
      "cssclass": ""
    }
  ]
}