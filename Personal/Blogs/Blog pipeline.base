filters:
  and:
    - file.inFolder("Personal/Blogs")
    - file.ext == "md"

formulas:
  status: 'if(file.hasProperty("published"), "Published", "Draft")'
  when: 'if(file.hasProperty("published"), date(published.toString()).relative(), "—")'
  words: '(file.size / 6).round()'
  stale: 'if(file.mtime < now() - "30d", "Untouched 30d+", "")'

properties:
  formula.status:
    displayName: Status
  formula.when:
    displayName: Published
  formula.words:
    displayName: ~Words
  formula.stale:
    displayName: Stale?
  note.published:
    displayName: Date
  file.mtime:
    displayName: Last edited

views:
  - type: table
    name: Pipeline
    groupBy:
      property: formula.status
      direction: ASC
    order:
      - file.name
      - formula.when
      - formula.words
      - file.mtime
      - formula.stale
    sort:
      - property: file.mtime
        direction: DESC

  - type: table
    name: Drafts
    filters:
      and:
        - '!file.hasProperty("published")'
    order:
      - file.name
      - formula.words
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC

  - type: cards
    name: Published
    filters:
      and:
        - file.hasProperty("published")
    order:
      - file.name
      - note.published
      - formula.words
    sort:
      - property: note.published
        direction: DESC
